<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A09CBB0" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#2E09CBB0" />
        </shape>
    </item>
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="#4D09CBB0" />
        </shape>
    </item>
    <item
        android:left="34dp"
        android:top="34dp"
        android:right="34dp"
        android:bottom="34dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="76dp"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="#1F2E2B"
                android:endColor="#0B1614" />
            <stroke
                android:width="2dp"
                android:color="#4FF2E6" />
        </shape>
    </item>
</layer-list>
